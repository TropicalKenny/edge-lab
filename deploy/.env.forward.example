# Copy to deploy/.env.forward on the VPS. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
FORWARD_INGEST_SECRET=replace-with-a-separate-long-random-secret

# Optional hosted dashboard. Create a remotely-managed Cloudflare Tunnel and put its
# connector token here only on the VPS. Cloudflare Access must protect the hostname
# before the tunnel is started.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Frozen Polymarket paper/shadow study defaults. Review before the first bootstrap;
# changing them later will be rejected for the same study external ID.
POLYMARKET_FORWARD_STUDY_EXTERNAL_ID=polymarket-structural-m6f-v1
POLYMARKET_FORWARD_INITIAL_CAPITAL_USD=1000
POLYMARKET_FORWARD_FEE_BUFFER_PCT=2
POLYMARKET_FORWARD_SHADOW_DELAY_MS=1000
POLYMARKET_FORWARD_OPERATION_COST_USD=0.25
POLYMARKET_FORWARD_PLANNED_LOSS_PCT=0.02
POLYMARKET_FORWARD_ATTEMPT_INTERVAL_SECONDS=300
POLYMARKET_FORWARD_MAX_ATTEMPTS_PER_CYCLE=3

# Frozen Solana Pump baseline. This is a pre-registered research baseline, not a tuned strategy.
# Changing these values later will be rejected for the same study external ID.
SOLANA_FORWARD_STUDY_EXTERNAL_ID=solana-pump-baseline-m6g-v1
SOLANA_FORWARD_INITIAL_CAPITAL_USD=1000
SOLANA_FORWARD_ENTRY_NOTIONAL_USD=25
SOLANA_FORWARD_DECISION_DELAY_MINUTES=5
SOLANA_FORWARD_MAX_CANDIDATE_AGE_MINUTES=30
SOLANA_FORWARD_HOLD_MINUTES=30
SOLANA_FORWARD_MAX_EXIT_DELAY_MINUTES=30
SOLANA_FORWARD_SHADOW_DELAY_MS=1000
SOLANA_FORWARD_MAX_QUOTE_PRICE_IMPACT_PCT=0.05
SOLANA_FORWARD_MIN_PREFLIGHT_EXIT_RATIO=0.90
SOLANA_FORWARD_MAX_OPEN_POSITIONS=5
SOLANA_FORWARD_MAX_ENTRIES_PER_CYCLE=3
SOLANA_FORWARD_NAV_INTERVAL_SECONDS=300
SOLANA_FORWARD_HEALTH_MAX_NAV_AGE_SECONDS=900
SOLANA_FORWARD_POLL_SECONDS=60

# Research-only provider credentials. These are data/API keys, never wallet/signing keys.
# Helius and Jupiter are required for the M6G forward runner.
HELIUS_API_KEY=
JUPITER_API_KEY=
GOPLUS_ACCESS_TOKEN=
