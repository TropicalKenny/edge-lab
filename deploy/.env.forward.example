# Copy to deploy/.env.forward on the VPS. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
FORWARD_INGEST_SECRET=replace-with-a-separate-long-random-secret

# M6I private owner-control plane. Keep these distinct from the main database password.
CONTROL_DB_PASSWORD=
OWNER_CONTROL_API_TOKEN=

# Hosted Dashboard V1. The app remains on VPS loopback 127.0.0.1:8080.
# Use a separate random password for the SELECT-only PostgreSQL role and a separate
# HMAC secret for the signed owner session. Never reuse trading/control credentials.
DASHBOARD_DB_PASSWORD=
DASHBOARD_OWNER_EMAIL=fafikennedy20@gmail.com
DASHBOARD_AUTH_SECRET=
DASHBOARD_RESEND_API_KEY=
DASHBOARD_AUTH_FROM_EMAIL=
DASHBOARD_OTP_TTL_SECONDS=600
DASHBOARD_OTP_COOLDOWN_SECONDS=60
DASHBOARD_OTP_MAX_ATTEMPTS=5
DASHBOARD_SESSION_TTL_SECONDS=43200

# Legacy direct cloudflared dashboard compose support. The current shared-VPS path may
# use a thin Cloudflare doorway while the actual Edge Lab dashboard stays on the VPS.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Dedicated Edge Lab Telegram bot. Long-polling is outbound from the VPS; no webhook is exposed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_CONTROL_POLL_TIMEOUT_SECONDS=25
TELEGRAM_CONTROL_RETRY_SECONDS=3

# Optional owner alerts. The same dedicated Edge Lab bot may send alerts as well as controls.
TELEGRAM_ALERT_POLL_SECONDS=60
TELEGRAM_ALERT_MAX_ATTEMPTS=6
TELEGRAM_ALERT_RETRY_BASE_SECONDS=60
TELEGRAM_ALERT_RETRY_MAX_SECONDS=3600
TELEGRAM_ALERT_BATCH_SIZE=20

# Frozen Polymarket paper/shadow study defaults. Review before the first bootstrap;
# changing them later will be rejected for the same study external ID.
POLYMARKET_FORWARD_STUDY_EXTERNAL_ID=polymarket-structural-m6f-v1
POLYMARKET_FORWARD_INITIAL_CAPITAL_USD=1000
POLYMARKET_FORWARD_FEE_BUFFER_PCT=2
POLYMARKET_FORWARD_SHADOW_DELAY_MS=1000
POLYMARKET_FORWARD_OPERATION_COST_USD=0.25
POLYMARKET_FORWARD_PLANNED_LOSS_PCT=0.02
POLYMARKET_FORWARD_ATTEMPT_INTERVAL_SECONDS=300
POLYMARKET_FORWARD_MAX_ATTEMPTS_PER_CYCLE=3

# Frozen Solana Pump baseline. This is a pre-registered research baseline, not a tuned strategy.
# Changing these values later will be rejected for the same study external ID.
SOLANA_FORWARD_STUDY_EXTERNAL_ID=solana-pump-baseline-m6g-v1
SOLANA_FORWARD_INITIAL_CAPITAL_USD=1000
SOLANA_FORWARD_ENTRY_NOTIONAL_USD=25
SOLANA_FORWARD_DECISION_DELAY_MINUTES=5
SOLANA_FORWARD_MAX_CANDIDATE_AGE_MINUTES=30
SOLANA_FORWARD_HOLD_MINUTES=30
SOLANA_FORWARD_MAX_EXIT_DELAY_MINUTES=30
SOLANA_FORWARD_SHADOW_DELAY_MS=1000
SOLANA_FORWARD_MAX_QUOTE_PRICE_IMPACT_PCT=0.05
SOLANA_FORWARD_MIN_PREFLIGHT_EXIT_RATIO=0.90
SOLANA_FORWARD_MAX_OPEN_POSITIONS=5
SOLANA_FORWARD_MAX_ENTRIES_PER_CYCLE=3
SOLANA_FORWARD_NAV_INTERVAL_SECONDS=300
SOLANA_FORWARD_HEALTH_MAX_NAV_AGE_SECONDS=900
SOLANA_FORWARD_POLL_SECONDS=60

# M6J Research Acceleration. This is observation-only challenger research and does not
# change M6C/M6F/M6G strategy configuration, simulated NAV, promotion evidence or safety gates.
M6J_ENABLED=true
M6J_HYPERLIQUID_POLL_SECONDS=900
M6J_HYPERLIQUID_COINS=BTC,ETH,SOL
M6J_HYPERLIQUID_HORIZONS_HOURS=24,168,336,720
M6J_HYPERLIQUID_HISTORY_HOURS=720
M6J_POLYMARKET_MAX_MARKETS=200
M6J_POLYMARKET_REFRESH_SECONDS=300
M6J_POLYMARKET_SUMMARY_SECONDS=60
M6J_POLYMARKET_MIN_EDGE_BPS=0
M6J_POLYMARKET_MAX_BOOK_AGE_SECONDS=5
M6J_SOLANA_POLL_SECONDS=60
M6J_SOLANA_CANDIDATE_AGE_MINUTES=120
M6J_SOLANA_MAX_SAMPLES_PER_CYCLE=20
M6J_SOLANA_MAX_OUTCOMES_PER_CYCLE=40
M6J_SOLANA_QUOTE_NOTIONAL_USD=25
M6J_SOLANA_OUTCOME_HORIZONS_MINUTES=5,15,30,60

# M6K Stage 2 strategy research. M6K reuses the existing observation-only M6J worker
# processes but writes separate m6k-hl/m6k-pm/m6k-sol telemetry lanes. These thresholds
# are preregistered research screens only. Passing them never promotes or changes a
# frozen forward study.
M6K_ENABLED=true
M6K_HYPERLIQUID_HISTORY_HOURS=2160
M6K_HYPERLIQUID_MIN_OBSERVATIONS=168
M6K_HYPERLIQUID_MIN_POSITIVE_FRACTION=0.70
M6K_HYPERLIQUID_MIN_BASELINE_FRACTION=0.50
M6K_HYPERLIQUID_MIN_STRESS_POSITIVE_FRACTION=0.50
M6K_HYPERLIQUID_MIN_CURRENT_BASELINE_STREAK=24
M6K_HYPERLIQUID_COST_STRESS_MULTIPLIER=2
M6K_POLYMARKET_BASELINE_EDGE_BPS=10
M6K_SOLANA_RESOLUTION_LOOKBACK_HOURS=72
M6K_SOLANA_RESOLUTION_MAX_PER_CYCLE=100

# Optional M6H lifecycle observation/accounting. These hypotheses do not change M6G.
LIFECYCLE_POLL_SECONDS=60
LIFECYCLE_MAX_OBSERVATION_AGE_MINUTES=1440
LIFECYCLE_MAX_FEATURE_AGE_MINUTES=15

# Research-only provider credentials. These are data/API keys or provider endpoints,
# never wallet/signing keys. The preferred path is standard Solana RPC so Edge Lab
# is not locked to one vendor. Alchemy can supply both endpoints below.
SOLANA_RPC_HTTP_URL=
SOLANA_RPC_WS_URL=
SOLANA_RPC_COMMITMENT=confirmed
SOLANA_RPC_TIMEOUT_SECONDS=10

# Optional legacy fallback. Leave blank when using the standard RPC endpoints above.
HELIUS_API_KEY=

# Jupiter remains quote-only; Edge Lab has no /execute path.
JUPITER_API_KEY=
GOPLUS_ACCESS_TOKEN=
