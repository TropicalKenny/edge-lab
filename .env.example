APP_ENV=development
DATABASE_URL=postgresql+psycopg://edge:edge@postgres:5432/edge
REDIS_URL=redis://redis:6379/0
SIGNER_ENABLED=false
RISK_MAX_NORMAL_LOSS_PCT=0.0025
RISK_MAX_EXCEPTIONAL_LOSS_PCT=0.005
RISK_DAILY_STOP_PCT=0.01
RISK_WEEKLY_STOP_PCT=0.03
RISK_MONTHLY_STOP_PCT=0.06
RISK_HALVE_AT_DRAWDOWN_PCT=0.10
RISK_FREEZE_AT_DRAWDOWN_PCT=0.15
RISK_MAX_MARKET_DATA_AGE_SECONDS=5
HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_TIMEOUT_SECONDS=10
HYPERLIQUID_MARKET_POLL_SECONDS=60
HYPERLIQUID_FUNDING_POLL_SECONDS=3600
HYPERLIQUID_FUNDING_COINS=BTC,ETH,SOL
